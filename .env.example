# API keys are read by `npm run setup` and registered in TrueForge. Which provider each key
# belongs to, its base URL and its models are set in config/models.json (providers[].apiKeyEnv).
# A provider whose key is empty is skipped with a WARN line.

# Primary provider key (Google Gemini key from Google AI Studio)
GEMINI_API_KEY=

# Inline fallback provider key (Groq in config/models.example.json; any OpenAI-compatible endpoint works)
SECONDARY_API_KEY=

# Agent-mode fallback provider key (NVIDIA build.nvidia.com in config/models.example.json)
NVIDIA_API_KEY=

# Local Flask 3.1.3 clone path for verification and test scripts
FLASK_DIR=./dev/forge-spike/flask

# TrueForge backend server URL (default: http://localhost:8790)
TRUEFORGE_URL=http://localhost:8790
