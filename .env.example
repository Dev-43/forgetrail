# Primary provider API key (Google Gemini free key from Google AI Studio)
GEMINI_API_KEY=

# Fallback provider configuration (OpenAI-compatible endpoint, e.g. Groq, OpenRouter, NVIDIA)
SECONDARY_API_KEY=
SECONDARY_BASE_URL=https://api.groq.com/openai/v1

# Optional NVIDIA API key (only if build.nvidia.com key is verified)
# NVIDIA_API_KEY=

# Local Flask 3.1.3 clone path for verification scripts
FLASK_DIR=./dev/forge-spike/flask

# TrueForge backend server URL (default: http://localhost:8790)
TRUEFORGE_URL=http://localhost:8790
