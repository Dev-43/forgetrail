{
  "name": "forgetrail",
  "displayName": "ForgeTrail",
  "description": "VS Code extension powered by TrueForge local agent loop",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:forgetrail.hello",
    "onCommand:forgetrail.inlineEdit",
    "onCommand:forgetrail.mockReview",
    "onCommand:forgetrail.openPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "forgetrail.hello",
        "title": "ForgeTrail: Hello"
      },
      {
        "command": "forgetrail.inlineEdit",
        "title": "ForgeTrail: Inline Edit"
      },
      {
        "command": "forgetrail.mockReview",
        "title": "ForgeTrail: Mock Review"
      },
      {
        "command": "forgetrail.review.accept",
        "title": "ForgeTrail: Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "forgetrail.review.reject",
        "title": "ForgeTrail: Reject Hunk",
        "icon": "$(x)"
      },
      {
        "command": "forgetrail.review.show",
        "title": "ForgeTrail: Show Review Diff"
      },
      {
        "command": "forgetrail.undoLast",
        "title": "ForgeTrail: Undo Last Edit"
      },
      {
        "command": "forgetrail.undoRun",
        "title": "ForgeTrail: Undo Run"
      },
      {
        "command": "forgetrail.openPanel",
        "title": "ForgeTrail: Open Agent Panel"
      }
    ],
    "keybindings": [
      {
        "command": "forgetrail.inlineEdit",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "forgetrail.review.accept",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "resourceScheme == forgetrail-proposed"
      },
      {
        "command": "forgetrail.review.reject",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "resourceScheme == forgetrail-proposed"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "forgetrail.review.accept",
          "when": "resourceScheme == forgetrail-proposed",
          "group": "navigation@1"
        },
        {
          "command": "forgetrail.review.reject",
          "when": "resourceScheme == forgetrail-proposed",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "forgetrail.inlineEdit",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsx --test test/*.test.ts",
    "trueforge": "node scripts/start-trueforge.mjs",
    "setup": "tsx scripts/setup.ts",
    "reset:flask": "tsx scripts/reset-flask.ts",
    "verify:a": "tsx scripts/verify.ts a",
    "verify:b": "tsx scripts/verify.ts b",
    "verify:c": "tsx scripts/verify.ts c",
    "test:task-a": "tsx scripts/test-task-a.ts",
    "test:task-b": "tsx scripts/test-task-b.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.184.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.13.4",
    "@types/vscode": "^1.93.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  }
}
